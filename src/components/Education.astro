---

<section id="formacion" class="education section-light">
	<div class="container">
		<div class="education-header">
			<div>
				<span class="section-number">// 04</span>
				<h2 class="section-title">Formación</h2>
			</div>
			<p class="education-motto">
				Formación<br />
				para seguir<br />
				avanzando
			</p>
		</div>
		<div class="education-inner">
			<div class="education-main">
				<div class="education-books">
					<span class="books-icon">📚</span>
				</div>
				<div class="education-list">
					<div class="education-item">
						<div class="education-dot"></div>
						<div>
							<h3 class="education-school">Universidad de Extremadura (UEX)</h3>
						</div>
					</div>
					<div class="education-item">
						<div class="education-dot"></div>
						<div>
							<h3 class="education-school">Trinity College Irlanda</h3>
							<p class="education-detail">Spoken English B3.</p>
						</div>
					</div>
				</div>
			</div>
			<div class="education-extra">
				<h3 class="education-extra-title">Formación adicional</h3>
				<div class="education-extra-card">
					<p class="education-extra-text">Siempre aprendiendo.<br />Aquí irán próximas formaciones.</p>
				</div>
				<div class="education-sticker">
					<span class="sticker-text">Same<br />Human<br />Bigger<br />Ideas</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.education {
		padding: 6rem 2rem;
		max-width: 1400px;
		margin: 0 auto;
	}

	.education-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 3rem;
		gap: 2rem;
	}

	.education-motto {
		font-family: var(--font-display);
		font-size: var(--font-size-lg);
		color: var(--color-text-dark);
		transform: rotate(-2deg);
		line-height: 1.3;
	}

	.education-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
	}

	.education-main {
		display: flex;
		gap: 3rem;
		align-items: flex-start;
	}

	.education-books {
		flex-shrink: 0;
	}

	.books-icon {
		font-size: 4rem;
		display: block;
	}

	.education-list {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.education-item {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
	}

	.education-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background-color: var(--color-text-dark);
		flex-shrink: 0;
		margin-top: 0.5rem;
	}

	.education-school {
		font-size: var(--font-size-xl);
		margin-bottom: 0.25rem;
	}

	.education-detail {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		color: var(--color-text-dark-muted);
	}

	.education-extra-title {
		font-size: var(--font-size-xl);
		margin-bottom: 1.5rem;
	}

	.education-extra-card {
		background-color: var(--color-surface-dark);
		color: var(--color-text-light);
		padding: 1.5rem;
		margin-bottom: 2rem;
		border: 1px solid rgba(242, 240, 234, 0.1);
	}

	.education-extra-text {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		color: var(--color-text-light-muted);
		line-height: 1.6;
	}

	.education-sticker {
		background-color: var(--color-text-dark);
		color: var(--color-text-light);
		padding: 1.5rem;
		transform: rotate(2deg);
		display: inline-block;
	}

	.sticker-text {
		font-family: var(--font-display);
		font-size: var(--font-size-lg);
		line-height: 1.2;
	}

	@media (max-width: 900px) {
		.education-inner {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
	}

	@media (max-width: 600px) {
		.education {
			padding: 4rem 1rem;
		}

		.education-header {
			flex-direction: column;
		}

		.education-main {
			flex-direction: column;
			gap: 2rem;
		}

		.education-school {
			font-size: var(--font-size-lg);
		}
	}
</style>
