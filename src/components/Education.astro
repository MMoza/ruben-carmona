---
---

<section id="formacion" class="education section-light">
	<div class="container">
		<div class="education-header">
			<span class="section-number">// 04</span>
			<h2 class="section-title">FORMACIÓN</h2>
		</div>
		<div class="education-pills">
			<span class="edu-pill edu-pill-acid">Trinity College Irlanda – Spoken English G3</span>
			<span class="edu-pill edu-pill-dark">Universidad de Extremadura (UEX)</span>
			<span class="edu-pill edu-pill-blue">Sector Seguridad: Vigilante de Seguridad</span>
		</div>
	</div>
</section>

<style>
	.education {
		position: relative;
		padding: 0;
		background-image: url('/images/bg-vertical-white.png');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}

	.education .container {
		position: relative;
		z-index: 1;
		max-width: 1400px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}

	.education-header {
		margin-bottom: 3rem;
	}

	.education .section-number {
		color: var(--color-text-dark-muted);
		display: block;
		margin-bottom: 0.5rem;
	}

	.education .section-title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 6vw, 5rem);
		font-weight: 700;
		text-transform: uppercase;
		line-height: 1;
		letter-spacing: -0.02em;
		color: var(--color-text-dark);
	}

	.education-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
	}

	.edu-pill {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-body);
		font-size: var(--font-size-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.5rem 1rem;
		transition: transform var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
	}

	.edu-pill-acid {
		background-color: var(--color-acid);
		color: var(--color-text-dark);
		transform: rotate(-2deg);
	}

	.edu-pill-acid:hover {
		transform: translate(-2px, -2px) rotate(-2deg);
		background-color: var(--color-electric-blue);
		color: var(--color-text-light);
		box-shadow: 6px 6px 0 var(--color-acid);
	}

	.edu-pill-dark {
		background-color: var(--color-text-dark);
		color: var(--color-text-light);
		transform: rotate(1.5deg);
	}

	.edu-pill-dark:hover {
		transform: translate(-2px, -2px) rotate(1.5deg);
		background-color: var(--color-text-light);
		color: var(--color-text-dark);
		box-shadow: 6px 6px 0 var(--color-text-dark);
	}

	.edu-pill-blue {
		background-color: var(--color-electric-blue);
		color: var(--color-text-light);
		transform: rotate(-1deg);
	}

	.edu-pill-blue:hover {
		transform: translate(-2px, -2px) rotate(-1deg);
		background-color: var(--color-acid);
		color: var(--color-text-dark);
		box-shadow: 6px 6px 0 var(--color-electric-blue);
	}

	@media (max-width: 600px) {
		.education .container {
			padding: 3rem 1rem;
		}
	}
</style>
