<section id="contacto" class="contact">
	<div class="container">
		<div class="contact-inner">
			<div class="contact-left">
				<span class="section-number">// 05</span>
				<h2 class="contact-title">CONTACTO</h2>
				<h3 class="contact-cta">¿HABLAMOS?</h3>
			</div>
			<div class="contact-right">
				<p class="contact-description">
					Cuéntame tu proyecto, una idea o simplemente saluda. Estoy siempre abierto a nuevas oportunidades.
				</p>
				<div class="contact-info">
					<a href="mailto:mort4delo@gmail.com" class="contact-item">
						<span class="contact-icon">✉</span> mort4delo@gmail.com
					</a>
					<a href="tel:+34657655482" class="contact-item">
						<span class="contact-icon"></span> +34 657 655 482
					</a>
					<a href="https://www.linkedin.com/in/rubén-carmona-domínguez-17a10323/" class="contact-item" target="_blank" rel="noopener">
						<span class="contact-icon">in</span> LinkedIn
					</a>
				</div>
				<a href="mailto:mort4delo@gmail.com" class="cta-button">
					Contactar <span class="arrow">→</span>
				</a>
			</div>
			<div class="contact-visual">
				<p class="contact-handwritten">
					Ideas<br />
					Proyectos<br />
					Personas <span class="arrow">→</span>
				</p>
				<img src="/images/logo-line.png" alt="" class="contact-line" />
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		position: relative;
		padding: 0;
		background-image: url('/images/bg-vertical-black.png');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}

	.contact .container {
		position: relative;
		z-index: 1;
		max-width: 1400px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}

	.contact-inner {
		display: grid;
		grid-template-columns: 1fr 1fr auto;
		gap: 4rem;
		align-items: start;
	}

	.contact-title {
		font-family: var(--font-display);
		font-size: var(--font-size-3xl);
		font-weight: 700;
		text-transform: uppercase;
		color: var(--color-text-light);
		margin-bottom: 1rem;
	}

	.contact-cta {
		font-family: var(--font-display);
		font-size: var(--font-size-4xl);
		font-weight: 700;
		text-transform: uppercase;
		color: var(--color-acid);
	}

	.contact-description {
		font-size: var(--font-size-md);
		color: var(--color-text-light-muted);
		line-height: 1.8;
		margin-bottom: 2rem;
		max-width: 350px;
	}

	.contact-info {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.contact-item {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		color: var(--color-text-light-muted);
		display: flex;
		align-items: center;
		gap: 0.75rem;
		transition: color var(--transition-fast);
	}

	.contact-item:hover {
		color: var(--color-acid);
	}

	.contact-icon {
		font-size: var(--font-size-lg);
		width: 24px;
		text-align: center;
	}

	.contact .cta-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.75rem 1.5rem;
		background-color: var(--color-electric-blue);
		color: var(--color-text-light);
		border: none;
		cursor: pointer;
		transition: background-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
	}

	.contact .cta-button:hover {
		background-color: var(--color-acid);
		color: var(--color-text-dark);
		transform: translate(-2px, -2px);
		box-shadow: 4px 4px 0 var(--color-electric-blue);
	}

	.contact .cta-button .arrow {
		transition: transform var(--transition-fast);
	}

	.contact .cta-button:hover .arrow {
		transform: translateX(4px);
	}

	.contact-visual {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	.contact-handwritten {
		font-family: var(--font-display);
		font-size: var(--font-size-xl);
		font-weight: 700;
		text-transform: uppercase;
		color: var(--color-text-light);
		transform: rotate(3deg);
		line-height: 1.4;
	}

	.contact-handwritten .arrow {
		color: var(--color-acid);
	}

	.contact-line {
		width: 150px;
		margin-top: 2rem;
		opacity: 0.5;
	}

	@media (max-width: 1000px) {
		.contact .container {
			padding: 3rem 2rem;
		}

		.contact-inner {
			grid-template-columns: 1fr 1fr;
			gap: 3rem;
		}

		.contact-visual {
			grid-column: 1 / -1;
			flex-direction: row;
			justify-content: flex-end;
			gap: 2rem;
		}
	}

	@media (max-width: 600px) {
		.contact .container {
			padding: 2rem 1rem;
		}

		.contact-inner {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.contact-cta {
			font-size: var(--font-size-3xl);
		}

		.contact-visual {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
