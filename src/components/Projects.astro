---
---

<section id="proyectos" class="projects section-dark">
	<div class="projects-overlay"></div>
	<div class="container">
		<div class="projects-header">
			<div>
				<span class="section-number">// 01</span>
				<h2 class="section-title">PROYECTOS / SOLUCIONES</h2>
			</div>
			<div class="projects-header-right">
				<p class="projects-tagline">TECNOLOGÍA<br />PARA UN MUNDO<br />MÁS PRÁCTICO.</p>
				<a href="#proyectos" class="cta-link">
					VER TODOS <span class="arrow">→</span>
				</a>
			</div>
		</div>
		<div class="projects-grid">
			<article class="project-card project-card-acid">
				<div class="project-image">
					<img src="/images/01-gijon.png" alt="Reserva Gijón" />
				</div>
				<div class="project-title-row">
					<h3 class="project-title">RESERVA GIJÓN</h3>
					<a href="#" class="project-btn project-btn-acid">VER MÁS <span class="arrow">→</span></a>
				</div>
				<p class="project-client">Ayuntamiento de Gijón</p>
				<p class="project-description">Plataforma web y APP móvil para gestión integral de reservas y dinamización turística. Integración de Visit Gijón Card.</p>
				<div class="project-tags">
					<span class="tag">App Móvil</span>
					<span class="tag">Motor Reserva</span>
					<span class="tag">Visit Gijón Card</span>
				</div>
			</article>
			<article class="project-card project-card-dark">
				<div class="project-image">
					<img src="/images/02-navarra.png" alt="Turismo Navarra" />
				</div>
				<div class="project-title-row">
					<h3 class="project-title">TURISMO NAVARRA</h3>
					<a href="#" class="project-btn project-btn-dark">VER MÁS <span class="arrow">→</span></a>
				</div>
				<p class="project-client">Gobierno de Navarra / Nasertic</p>
				<p class="project-description">Portal livenavarra.com. Centralización de alojamientos, actividades y patrimonio cultural con canal único de reservas.</p>
				<div class="project-tags">
					<span class="tag">Marketplace Regional</span>
					<span class="tag">Turismo Navarra</span>
					<span class="tag">Nasertic</span>
				</div>
			</article>
			<article class="project-card project-card-blue">
				<div class="project-image">
					<img src="/images/03-ntur.png" alt="Proyecto Ñtur" />
				</div>
				<div class="project-title-row">
					<h3 class="project-title">PROYECTO ÑTUR</h3>
					<a href="#" class="project-btn project-btn-blue">VER MÁS <span class="arrow">→</span></a>
				</div>
				<p class="project-client">Fundetec</p>
				<p class="project-description">Impulso TIC en turismo rural. Modelo de gestión avanzado para pymes y transformación digital del sector.</p>
				<div class="project-tags">
					<span class="tag">Turismo Rural</span>
					<span class="tag">Innovación TIC</span>
					<span class="tag">Fundetec</span>
				</div>
			</article>
		</div>
	</div>
	<img src="/images/separator-yellow.png" alt="" class="projects-separator projects-separator-bottom" />
</section>

<style>
	.projects {
		position: relative;
		padding: 0;
		background-image: url('/images/bg-projects.png');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}

	.projects-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(
			180deg,
			rgba(9, 9, 9, 0.85) 0%,
			rgba(9, 9, 9, 0.75) 50%,
			rgba(9, 9, 9, 0.85) 100%
		);
		z-index: 0;
	}

	.projects .container {
		position: relative;
		z-index: 1;
		max-width: 1400px;
		margin: 0 auto;
		padding: 5rem 2rem;
	}

	.projects-separator {
		position: absolute;
		left: 50%;
		width: 100%;
		max-width: 1600px;
		opacity: 0.9;
		z-index: 10;
		pointer-events: none;
	}

	.projects-separator-bottom {
		bottom: 0;
		transform: translate(-50%, 50%);
	}

	.projects-separator-top {
		top: -240px;
	}

	.projects-separator-bottom {
		bottom: -12px;
	}

	.projects-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 2.5rem;
		gap: 2rem;
	}

	.projects .section-title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 6vw, 5rem);
		font-weight: 700;
		text-transform: uppercase;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.projects-header-right {
		text-align: right;
	}

	.projects-tagline {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-text-light-muted);
		line-height: 1.6;
		margin-bottom: 1rem;
	}

	.cta-link {
		font-family: var(--font-display);
		font-size: var(--font-size-md);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-acid);
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		transition: gap var(--transition-fast);
	}

	.cta-link:hover {
		gap: 1rem;
	}

	.projects-grid {
		display: flex;
		gap: 1rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		-webkit-overflow-scrolling: touch;
		padding: 1.5rem 0 1rem 0;
		justify-content: center;
	}

	.projects-grid::-webkit-scrollbar {
		height: 4px;
	}

	.projects-grid::-webkit-scrollbar-track {
		background: transparent;
	}

	.projects-grid::-webkit-scrollbar-thumb {
		background: transparent;
	}

	.projects-grid:hover::-webkit-scrollbar-thumb {
		background: var(--color-text-light-muted);
	}

	.project-card {
		flex: 0 0 calc((100% - 2rem) / 3);
		max-width: 420px;
		min-width: 280px;
		scroll-snap-align: start;
		border: 1px solid rgba(242, 240, 234, 0.15);
		transition: transform var(--transition-fast), border-color var(--transition-fast), opacity var(--transition-fast);
	}

	.projects-grid:hover .project-card {
		opacity: 0.5;
	}

	.projects-grid .project-card:hover {
		opacity: 1;
	}

	.project-card:first-child {
		margin-left: 1rem;
	}

	.project-card:last-child {
		margin-right: 1rem;
	}

	.project-card-acid:hover {
		border-color: var(--color-acid);
		transform: scale(1.03);
		box-shadow: 0 0 8px var(--color-acid), 0 0 20px rgba(215, 248, 33, 0.3);
	}

	.project-card-dark:hover {
		border-color: var(--color-text-light);
		transform: scale(1.03);
		box-shadow: 0 0 8px var(--color-text-light), 0 0 20px rgba(242, 240, 234, 0.2);
	}

	.project-card-blue:hover {
		border-color: var(--color-electric-blue);
		transform: scale(1.03);
		box-shadow: 0 0 8px var(--color-electric-blue), 0 0 20px rgba(72, 39, 253, 0.3);
	}

	.project-title-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.75rem 0.75rem 0.25rem;
	}

	.project-btn {
		font-family: var(--font-body);
		font-size: var(--font-size-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.5rem 1rem;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-shrink: 0;
		transition: transform var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
	}

	.project-btn .arrow {
		transition: transform var(--transition-fast);
	}

	.project-btn:hover .arrow {
		transform: translateX(4px);
	}

	.project-btn-acid {
		background-color: var(--color-acid);
		color: var(--color-text-dark);
	}

	.project-btn-acid:hover {
		transform: translate(-2px, -2px) rotate(-2deg);
		background-color: var(--color-electric-blue);
		color: var(--color-text-light);
		box-shadow: 6px 6px 0 var(--color-acid);
	}

	.project-btn-dark {
		background-color: var(--color-text-light-muted);
		color: var(--color-text-dark);
	}

	.project-btn-dark:hover {
		transform: translate(-2px, -2px) rotate(1.5deg);
		background-color: var(--color-text-dark);
		color: var(--color-text-light);
		box-shadow: 6px 6px 0 var(--color-text-light);
	}

	.project-btn-blue {
		background-color: var(--color-electric-blue);
		color: var(--color-text-light);
	}

	.project-btn-blue:hover {
		transform: translate(-2px, -2px) rotate(-1deg);
		background-color: var(--color-acid);
		color: var(--color-text-dark);
		box-shadow: 6px 6px 0 var(--color-electric-blue);
	}

	.project-client {
		font-size: var(--font-size-xs);
		color: var(--color-acid);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.25rem 0.75rem 0.5rem;
	}

	.project-card-dark .project-client {
		color: var(--color-text-light-muted);
	}

	.project-card-blue .project-client {
		color: var(--color-electric-blue);
	}

	.project-image {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		position: relative;
	}

	.project-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform var(--transition-fast);
	}

	.project-card:hover .project-image img {
		transform: scale(1.05);
	}

	.project-title {
		font-family: var(--font-display);
		font-size: var(--font-size-lg);
		font-weight: 700;
		text-transform: uppercase;
		padding: 0;
	}

	.project-description {
		font-size: var(--font-size-sm);
		color: var(--color-text-light-muted);
		padding: 0 0.75rem;
		line-height: 1.5;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0.75rem;
	}

	.tag {
		font-family: var(--font-body);
		font-size: 0.65rem;
		background: linear-gradient(135deg, rgba(242, 240, 234, 0.95) 0%, rgba(220, 218, 212, 0.95) 100%);
		color: var(--color-text-dark);
		padding: 0.35rem 0.6rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		border: 1px solid rgba(242, 240, 234, 0.3);
	}

	@media (max-width: 600px) {
		.projects .container {
			padding: 3rem 1rem;
		}

		.projects-header {
			flex-direction: column;
		}

		.projects-header-right {
			text-align: left;
		}

		.project-card {
			flex: 0 0 240px;
			min-width: 240px;
		}
	}
</style>
