---
---

<section id="proyectos" class="projects section-dark">
	<div class="container">
		<div class="projects-header">
			<div>
				<span class="section-number">// 01</span>
				<h2 class="section-title">PROYECTOS / SOLUCIONES</h2>
			</div>
			<div class="projects-header-right">
				<p class="projects-tagline">TECNOLOGÍA<br />PARA UN MUNDO<br />MÁS PRÁCTICO.</p>
				<a href="#proyectos" class="cta-link">
					VER TODOS <span class="arrow">→</span>
				</a>
			</div>
		</div>
		<div class="projects-grid">
			<article class="project-card">
				<div class="project-image project-image-acid">
					<div class="project-image-content">
						<span class="project-image-text">FANTASY<br />SPORTS<br />DATA<br />USERS</span>
					</div>
				</div>
				<h3 class="project-title">APLICACIONES WEB</h3>
				<p class="project-description">Desarrollo de aplicaciones web a medida, PHP, bases de datos y experiencias para usuarios reales.</p>
				<div class="project-tags">
					<span class="tag">#php</span>
					<span class="tag">#web</span>
					<span class="tag">#deporte</span>
					<span class="tag">#datos</span>
				</div>
			</article>
			<article class="project-card">
				<div class="project-image project-image-dark">
					<div class="project-image-content">
						<span class="project-image-text">DASHBOARD<br />ANALYTICS</span>
					</div>
				</div>
				<h3 class="project-title">GESTIÓN Y ERP</h3>
				<p class="project-description">Soluciones de gestión, ERP y herramientas internas para optimizar procesos y equipos.</p>
				<div class="project-tags">
					<span class="tag">#erp</span>
					<span class="tag">#crm</span>
					<span class="tag">#procesos</span>
					<span class="tag">#automatización</span>
				</div>
			</article>
			<article class="project-card">
				<div class="project-image project-image-dark">
					<div class="project-image-content">
						<span class="project-image-text">CORPORATE<br />WEB</span>
					</div>
				</div>
				<h3 class="project-title">WEBS CORPORATIVAS</h3>
				<p class="project-description">Diseño y desarrollo de sitios corporativos, CMS, SEO y una imagen que transmite confianza.</p>
				<div class="project-tags">
					<span class="tag">#cms</span>
					<span class="tag">#diseño</span>
					<span class="tag">#seo</span>
					<span class="tag">#empresa</span>
				</div>
			</article>
			<article class="project-card">
				<div class="project-image project-image-acid">
					<div class="project-image-content">
						<span class="project-image-text">AUTOMATE<br />SIMPLIFY<br />IMPROVE</span>
					</div>
				</div>
				<h3 class="project-title">AUTOMATIZACIÓN</h3>
				<p class="project-description">Integraciones, scripts y automatización de tareas para ahorrar tiempo y evitar errores.</p>
				<div class="project-tags">
					<span class="tag">#integraciones</span>
					<span class="tag">#scripts</span>
					<span class="tag">#apis</span>
				</div>
			</article>
		</div>
	</div>
</section>

<style>
	.projects {
		padding: 5rem 2rem;
		max-width: 1400px;
		margin: 0 auto;
	}

	.projects-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 2.5rem;
		gap: 2rem;
	}

	.projects .section-title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 6vw, 5rem);
		font-weight: 700;
		text-transform: uppercase;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.projects-header-right {
		text-align: right;
	}

	.projects-tagline {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-text-light-muted);
		line-height: 1.6;
		margin-bottom: 1rem;
	}

	.cta-link {
		font-family: var(--font-display);
		font-size: var(--font-size-md);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-acid);
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		transition: gap var(--transition-fast);
	}

	.cta-link:hover {
		gap: 1rem;
	}

	.projects-grid {
		display: flex;
		gap: 1rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		-webkit-overflow-scrolling: touch;
		padding-bottom: 1rem;
	}

	.projects-grid::-webkit-scrollbar {
		height: 4px;
	}

	.projects-grid::-webkit-scrollbar-track {
		background: var(--color-surface-dark);
	}

	.projects-grid::-webkit-scrollbar-thumb {
		background: var(--color-text-light-muted);
	}

	.project-card {
		flex: 0 0 280px;
		scroll-snap-align: start;
	}

	.project-card {
		border: 1px solid rgba(242, 240, 234, 0.15);
		transition: border-color var(--transition-fast);
	}

	.project-card:hover {
		border-color: var(--color-acid);
	}

	.project-image {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		position: relative;
	}

	.project-image-acid {
		background-color: var(--color-acid);
	}

	.project-image-dark {
		background-color: var(--color-surface-dark);
	}

	.project-image-content {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.project-image-text {
		font-family: var(--font-display);
		font-size: var(--font-size-lg);
		font-weight: 700;
		text-transform: uppercase;
		line-height: 1.1;
	}

	.project-image-acid .project-image-text {
		color: var(--color-text-dark);
	}

	.project-image-dark .project-image-text {
		color: var(--color-text-light-muted);
	}

	.project-title {
		font-family: var(--font-display);
		font-size: var(--font-size-lg);
		font-weight: 700;
		text-transform: uppercase;
		padding: 0.75rem 0.75rem 0.25rem;
	}

	.project-description {
		font-size: var(--font-size-sm);
		color: var(--color-text-light-muted);
		padding: 0 0.75rem;
		line-height: 1.5;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0.75rem;
	}

	@media (max-width: 600px) {
		.projects {
			padding: 3rem 1rem;
		}

		.projects-header {
			flex-direction: column;
		}

		.projects-header-right {
			text-align: left;
		}

		.project-card {
			flex: 0 0 240px;
		}
	}
</style>
