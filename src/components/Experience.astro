---
---

<section id="experiencia" class="experience">
	<div class="container">
		<div class="experience-header">
			<div>
				<span class="section-number">// 03</span>
				<h2 class="section-title">EXPERIENCIA</h2>
			</div>
		</div>
		<div class="experience-timeline">
			<div class="timeline-item timeline-item-current">
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-header">
						<h3 class="timeline-company">MisterPlan</h3>
					</div>
					<div class="timeline-role-row">
						<p class="timeline-role">Partners Sales Manager</p>
						<span class="timeline-badge">+16 años</span>
					</div>
					<p class="timeline-location">Cáceres, España • Desde 2010 hasta la actualidad</p>
					<ul class="timeline-list">
						<li>Coordinación de equipos de trabajo y departamento</li>
						<li>Gestión y ejecución de proyectos</li>
						<li>Gestión de grandes cuentas clientes</li>
						<li>Marketing y diseño</li>
					</ul>
				</div>
				<img src="/images/mr-plan-ruben.png" alt="MisterPlan Logo" class="timeline-logo" />
			</div>
			<div class="timeline-item">
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<h3 class="timeline-company">Grupo Vinsa</h3>
					<div class="timeline-details">
						<p class="timeline-role">Vigilante de Seguridad — Madrid</p>
						<p class="timeline-description">Seguridad en FNAC Callao, El Corte Inglés Princesa y El Corte Inglés Barrio del Pilar.</p>
					</div>
					<button class="timeline-toggle">Ver más</button>
				</div>
			</div>
			<div class="timeline-item">
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<h3 class="timeline-company">Aldeasa</h3>
					<div class="timeline-details">
						<p class="timeline-role">Responsable de Almacén, Tienda T3</p>
						<p class="timeline-description">Aeropuerto Adolfo Suárez, Madrid. Gestión de personal, control de stock, distribución y logística.</p>
					</div>
					<button class="timeline-toggle">Ver más</button>
				</div>
			</div>
			<div class="timeline-item">
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<h3 class="timeline-company">Factor Ocio</h3>
					<div class="timeline-details">
						<p class="timeline-role">Director Comercial / Patrón de aguas intercontinentales</p>
						<p class="timeline-description">Barco del Tajo, Cáceres. Dirección comercial y patrón de barco para 80 pasajeros.</p>
					</div>
					<button class="timeline-toggle">Ver más</button>
				</div>
			</div>
		</div>
		<div class="experience-footer">
			<p class="experience-footer-text">Experiencias<br />que suman.</p>
		</div>
	</div>
</section>

<style>
	.experience {
		position: relative;
		padding: 0;
		background-image: url('/images/bg-vertical-black.png');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}

	.experience .container {
		position: relative;
		z-index: 1;
		max-width: 1400px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}

	.experience-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 4rem;
		gap: 2rem;
	}

	.experience .section-title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 6vw, 5rem);
		font-weight: 700;
		text-transform: uppercase;
		line-height: 1;
		letter-spacing: -0.02em;
		color: var(--color-text-light);
	}

	.experience-timeline {
		position: relative;
		padding-left: 3rem;
	}

	.experience-timeline::before {
		content: '';
		position: absolute;
		left: 6px;
		top: 0;
		bottom: 0;
		width: 2px;
		background-color: rgba(242, 240, 234, 0.2);
	}

	.timeline-item {
		position: relative;
		margin-bottom: 3rem;
	}

	.timeline-item-current {
		margin-bottom: 3rem;
		position: relative;
		opacity: 1;
	}

	.timeline-item-current .timeline-dot {
		background-color: var(--color-acid);
		border-color: var(--color-acid);
		box-shadow: 0 0 8px var(--color-acid), 0 0 16px var(--color-acid);
	}

	.timeline-item-current .timeline-company {
		color: var(--color-acid);
		font-size: var(--font-size-3xl);
		transform: rotate(-1.5deg);
		display: inline-block;
	}

	.timeline-role-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.timeline-badge {
		font-family: var(--font-body);
		font-size: var(--font-size-xs);
		color: var(--color-text-light-muted);
		padding: 0.2rem 0.5rem;
		font-weight: 700;
		display: inline-block;
		transition: transform var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
	}

	.timeline-item-current:hover .timeline-badge {
		transform: rotate(-5deg);
		background-color: var(--color-electric-blue);
		color: var(--color-text-light);
	}

	.timeline-logo {
		display: none;
		position: absolute;
		right: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 450px;
		opacity: 0;
		transition: opacity var(--transition-fast);
		pointer-events: none;
	}

	@media (min-width: 900px) {
		.timeline-item-current {
			padding-right: 340px;
		}

		.timeline-item-current:hover .timeline-logo {
			display: block;
			opacity: 1;
		}
	}

	.experience-timeline .timeline-item:not(.timeline-item-current) {
		opacity: 0.6;
		transition: opacity var(--transition-fast);
	}

	.experience-timeline .timeline-item:not(.timeline-item-current):hover {
		opacity: 1;
	}

	.timeline-header {
		margin-bottom: 0.5rem;
	}

	.timeline-location {
		font-size: var(--font-size-sm);
		color: var(--color-text-light-muted);
		margin-bottom: 1rem;
	}

	.timeline-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.timeline-list li {
		font-size: var(--font-size-sm);
		color: var(--color-text-light-muted);
		margin-bottom: 0.25rem;
		padding-left: 1rem;
		position: relative;
	}

	.timeline-list li::before {
		content: '•';
		position: absolute;
		left: 0;
		color: var(--color-acid);
	}

	.timeline-dot {
		position: absolute;
		left: -3rem;
		top: 0.5rem;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background-color: var(--color-bg-dark);
		border: 2px solid var(--color-acid);
	}

	.timeline-company {
		font-family: var(--font-display);
		font-size: var(--font-size-2xl);
		font-weight: 700;
		text-transform: uppercase;
		color: var(--color-text-light);
		margin-bottom: 0.5rem;
		transition: transform var(--transition-fast);
	}

	.timeline-item:nth-child(1):hover .timeline-company {
		transform: rotate(-3deg);
	}

	.timeline-item:nth-child(2):hover .timeline-company {
		transform: rotate(1.5deg);
	}

	.timeline-item:nth-child(3):hover .timeline-company {
		transform: rotate(-1.5deg);
	}

	.timeline-item:nth-child(4):hover .timeline-company {
		transform: rotate(2deg);
	}

	.timeline-role {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		color: var(--color-acid);
		margin-bottom: 0.75rem;
	}

	.timeline-description {
		font-size: var(--font-size-sm);
		color: var(--color-text-light-muted);
		line-height: 1.6;
		max-width: 500px;
	}

	.timeline-details {
		display: none;
		margin-top: 0.75rem;
	}

	.timeline-item.expanded .timeline-details {
		display: block;
	}

	.timeline-toggle {
		background: none;
		border: none;
		color: var(--color-acid);
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		cursor: pointer;
		padding: 0;
		margin-top: 0.5rem;
		transition: opacity var(--transition-fast);
	}

	.timeline-toggle:hover {
		opacity: 0.8;
	}

	.experience-footer {
		margin-top: 3rem;
		text-align: right;
	}

	.experience-footer-text {
		font-family: var(--font-display);
		font-size: var(--font-size-xl);
		font-weight: 700;
		text-transform: uppercase;
		color: var(--color-text-light);
		transform: rotate(-3deg);
		display: inline-block;
		line-height: 1.3;
	}

	@media (max-width: 900px) {
		.experience .container {
			padding: 3rem 2rem;
		}
	}

	@media (max-width: 600px) {
		.experience .container {
			padding: 2rem 1rem;
		}

		.experience-timeline {
			padding-left: 2rem;
		}

		.timeline-dot {
			left: -2rem;
		}

		.timeline-company {
			font-size: var(--font-size-xl);
		}
	}
</style>

<script>
	document.querySelectorAll('.timeline-toggle').forEach((btn) => {
		btn.addEventListener('click', () => {
			const item = btn.closest('.timeline-item');
			const isExpanded = item.classList.toggle('expanded');
			btn.textContent = isExpanded ? 'Ver menos' : 'Ver más';
		});
	});
</script>
