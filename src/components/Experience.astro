---
---

<section id="experiencia" class="experience">
	<div class="container">
		<div class="experience-header">
			<div>
				<span class="section-number">// 03</span>
				<h2 class="section-title">EXPERIENCIA</h2>
			</div>
			<div class="experience-side">
				<div class="experience-signs">
					<span class="sign">Personas</span>
					<span class="sign">Organización</span>
					<span class="sign">Resultados</span>
				</div>
				<p class="experience-motto">
					Distintos<br />
					caminos<br />
					misma actitud
				</p>
			</div>
		</div>
		<div class="experience-timeline">
			<div class="timeline-item">
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<h3 class="timeline-company">Grupo Vinsa</h3>
					<p class="timeline-role">Vigilante de Seguridad — Madrid</p>
					<p class="timeline-description">Seguridad en FNAC Callao, El Corte Inglés Princesa y El Corte Inglés Barrio del Pilar.</p>
				</div>
			</div>
			<div class="timeline-item">
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<h3 class="timeline-company">Aldeasa</h3>
					<p class="timeline-role">Responsable de Almacén, Tienda T3</p>
					<p class="timeline-description">Aeropuerto Adolfo Suárez, Madrid. Gestión de personal, control de stock, distribución y logística.</p>
				</div>
			</div>
			<div class="timeline-item">
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<h3 class="timeline-company">Factor Ocio</h3>
					<p class="timeline-role">Director Comercial / Patrón de aguas intercontinentales</p>
					<p class="timeline-description">Barco del Tajo, Cáceres. Dirección comercial y patrón de barco para 80 pasajeros.</p>
				</div>
			</div>
		</div>
		<div class="experience-footer">
			<p class="experience-footer-text">Experiencias<br />que suman.</p>
		</div>
	</div>
</section>

<style>
	.experience {
		position: relative;
		padding: 0;
		background-image: url('/images/bg-vertical-black.png');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}

	.experience .container {
		position: relative;
		z-index: 1;
		max-width: 1400px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}

	.experience-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 4rem;
		gap: 2rem;
	}

	.experience .section-title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 6vw, 5rem);
		font-weight: 700;
		text-transform: uppercase;
		line-height: 1;
		letter-spacing: -0.02em;
		color: var(--color-text-light);
	}

	.experience-side {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 2rem;
	}

	.experience-signs {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.sign {
		font-family: var(--font-display);
		font-size: var(--font-size-lg);
		font-weight: 700;
		text-transform: uppercase;
		background-color: var(--color-surface-dark);
		color: var(--color-text-light);
		padding: 0.75rem 1.5rem;
		border: 1px solid rgba(242, 240, 234, 0.2);
		transform: rotate(-2deg);
		display: inline-block;
	}

	.sign:nth-child(2) {
		transform: rotate(1deg);
		margin-left: 1rem;
	}

	.sign:nth-child(3) {
		transform: rotate(-1deg);
		margin-left: 0.5rem;
	}

	.experience-motto {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		color: var(--color-text-light-muted);
		text-align: right;
		line-height: 1.6;
	}

	.experience-timeline {
		position: relative;
		padding-left: 3rem;
	}

	.experience-timeline::before {
		content: '';
		position: absolute;
		left: 6px;
		top: 0;
		bottom: 0;
		width: 2px;
		background-color: rgba(242, 240, 234, 0.2);
	}

	.timeline-item {
		position: relative;
		margin-bottom: 3rem;
	}

	.timeline-dot {
		position: absolute;
		left: -3rem;
		top: 0.5rem;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background-color: var(--color-bg-dark);
		border: 2px solid var(--color-acid);
	}

	.timeline-company {
		font-family: var(--font-display);
		font-size: var(--font-size-2xl);
		font-weight: 700;
		text-transform: uppercase;
		color: var(--color-text-light);
		margin-bottom: 0.5rem;
	}

	.timeline-role {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		color: var(--color-acid);
		margin-bottom: 0.75rem;
	}

	.timeline-description {
		font-size: var(--font-size-sm);
		color: var(--color-text-light-muted);
		line-height: 1.6;
		max-width: 500px;
	}

	.experience-footer {
		margin-top: 3rem;
		text-align: right;
	}

	.experience-footer-text {
		font-family: var(--font-display);
		font-size: var(--font-size-xl);
		font-weight: 700;
		text-transform: uppercase;
		color: var(--color-text-light);
		transform: rotate(-3deg);
		display: inline-block;
		line-height: 1.3;
	}

	@media (max-width: 900px) {
		.experience .container {
			padding: 3rem 2rem;
		}

		.experience-header {
			flex-direction: column;
		}

		.experience-side {
			align-items: flex-start;
		}

		.experience-motto {
			text-align: left;
		}
	}

	@media (max-width: 600px) {
		.experience .container {
			padding: 2rem 1rem;
		}

		.experience-timeline {
			padding-left: 2rem;
		}

		.timeline-dot {
			left: -2rem;
		}

		.timeline-company {
			font-size: var(--font-size-xl);
		}

		.sign {
			font-size: var(--font-size-md);
			padding: 0.5rem 1rem;
		}
	}
</style>
