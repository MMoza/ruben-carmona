<style>
	.footer {
		position: relative;
		padding: 0;
		background-image: url('/images/bg-footer.png');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}

	.footer::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(242, 240, 234, 0.4), transparent);
	}

	.footer::after {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 90%;
		background: linear-gradient(180deg, rgba(217, 251, 0, 0.1), transparent);
		pointer-events: none;
	}

	.footer-inner {
		max-width: 1400px;
		margin: 0 auto;
		padding: 1rem 1rem 1rem;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
		margin-bottom: 3rem;
	}

	.footer-col-left {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.footer-logo {
		width: 240px;
		height: 100px;
		object-fit: contain;
		margin-bottom: 0.75rem;
	}

	.footer-name {
		font-family: var(--font-display);
		font-size: var(--font-size-xl);
		font-weight: 700;
		text-transform: uppercase;
		color: var(--color-text-light);
		letter-spacing: 0.02em;
	}

	.footer-role {
		font-family: var(--font-body);
		font-size: var(--font-size-md);
		color: var(--color-text-light-muted);
		letter-spacing: 0.04em;
	}

	.footer-col-right {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 2rem;
	}

	.footer-icon-link {
		text-decoration: none;
	}

	.footer-icon-box {
		width: 40px;
		height: 40px;
		padding: 0.25rem;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
	}

	.footer-icon-box.icon-email {
		background-color: var(--color-acid);
		border-color: var(--color-acid);
	}

	.footer-icon-box.icon-email svg {
		color: var(--color-text-dark);
	}

	.footer-icon-box.icon-white {
		background-color: var(--color-text-light);
		border-color: var(--color-text-light);
	}

	.footer-icon-box.icon-white svg {
		color: var(--color-text-dark);
	}

	.footer-icon-box.icon-blue {
		background-color: var(--color-electric-blue);
		border-color: var(--color-electric-blue);
	}

	.footer-icon-box.icon-blue svg {
		color: var(--color-text-light);
	}

	.footer-icon-box.icon-email:hover {
		transform: translate(-2px, -2px) rotate(-2deg);
		box-shadow: 4px 4px 0 var(--color-electric-blue);
	}

	.footer-icon-box.icon-white:hover {
		transform: translate(-2px, -2px) rotate(1deg);
		box-shadow: 4px 4px 0 var(--color-acid);
	}

	.footer-icon-box.icon-blue:hover {
		transform: translate(-2px, -2px) rotate(-1.5deg);
		box-shadow: 4px 4px 0 var(--color-acid);
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 2.5rem;
	}

	.footer-copyright {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		color: var(--color-text-light-muted);
		letter-spacing: 0.04em;
	}

	.footer-credit {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		color: var(--color-text-light-muted);
		letter-spacing: 0.04em;
	}

	.footer-credit a {
		color: var(--color-text-light);
		text-decoration: underline;
		text-decoration-color: rgba(242, 240, 234, 0.3);
		text-underline-offset: 4px;
		transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
	}

	.footer-credit a:hover {
		color: var(--color-acid);
		text-decoration-color: var(--color-acid);
	}

	@media (max-width: 768px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.footer-bottom {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}

		.footer-logo {
			width: 80px;
			height: 80px;
		}

		.footer-icon-box {
			width: 52px;
			height: 52px;
		}

		.footer-icon-box svg {
			width: 24px;
			height: 24px;
		}
	}
</style>
