---

<footer class="footer">
	<div class="footer-inner">
		<div class="footer-left">
			<span class="footer-name">Rubén Carmona Domínguez</span>
			<span class="footer-divider">/</span>
			<span class="footer-role">Consultor TIC</span>
		</div>
		<div class="footer-right">
			<span class="footer-tagline">Tecnología que resuelve problemas.</span>
			<span class="footer-plus">+</span>
		</div>
	</div>
</footer>

<style>
	.footer {
		padding: 1.5rem 2rem;
		border-top: 1px solid rgba(242, 240, 234, 0.1);
		background-color: var(--color-bg-dark);
	}

	.footer-inner {
		max-width: 1400px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.footer-left {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.footer-name {
		font-family: var(--font-display);
		font-size: var(--font-size-lg);
		color: var(--color-text-light);
	}

	.footer-divider {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		color: var(--color-text-light-muted);
	}

	.footer-role {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		color: var(--color-text-light-muted);
		letter-spacing: 0.04em;
	}

	.footer-right {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.footer-tagline {
		font-family: var(--font-body);
		font-size: var(--font-size-xs);
		color: var(--color-text-light-muted);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.footer-plus {
		font-family: var(--font-body);
		font-size: var(--font-size-lg);
		color: var(--color-text-light-muted);
	}

	@media (max-width: 600px) {
		.footer-inner {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}

		.footer-left {
			flex-direction: column;
			gap: 0.25rem;
		}
	}
</style>
